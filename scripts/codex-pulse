#!/usr/bin/env node
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn, spawnSync } = require("child_process");

const HOME = os.homedir();
const CODEX_HOME = process.env.CODEX_HOME || path.join(HOME, ".codex");
const STATE_DB = path.join(CODEX_HOME, "state_5.sqlite");
const AUTH_FILE = path.join(CODEX_HOME, "auth.json");
const CONFIG_FILE = path.join(CODEX_HOME, "config.toml");

function usage() {
  console.log(`codex-pulse

Usage:
  codex-pulse                 Show /status-style snapshot
  codex-pulse status          Show /status-style snapshot
  codex-pulse statusline      Print compact one-line summary
  codex-pulse watch [-i SEC]  Refresh in place every SEC seconds
  codex-pulse json            Print collected JSON
  codex-pulse help

Data sources:
  - Codex app-server account/rateLimits/read for current 5h/weekly limits
  - ~/.codex/state_5.sqlite for latest session metadata
  - ~/.codex/sessions/**/*.jsonl token_count events for token usage
`);
}

function compactHome(value) {
  if (!value) return value;
  return value === HOME ? "~" : value.startsWith(HOME + path.sep) ? "~" + value.slice(HOME.length) : value;
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (_) {
    return null;
  }
}

function decodeJwtPayload(token) {
  if (!token || typeof token !== "string" || !token.includes(".")) return {};
  try {
    let payload = token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
    payload += "=".repeat((4 - (payload.length % 4)) % 4);
    return JSON.parse(Buffer.from(payload, "base64").toString("utf8"));
  } catch (_) {
    return {};
  }
}

function readAuthInfo() {
  const auth = readJson(AUTH_FILE);
  const tokens = auth && auth.tokens ? auth.tokens : {};
  const claims = decodeJwtPayload(tokens.id_token || tokens.access_token);
  const openaiAuth = claims["https://api.openai.com/auth"] || {};
  return {
    email: claims.email || null,
    plan: openaiAuth.chatgpt_plan_type || null,
    accountId: tokens.account_id || openaiAuth.chatgpt_account_id || null,
  };
}

function parseSimpleToml(file) {
  const out = {};
  let section = "";
  try {
    const lines = fs.readFileSync(file, "utf8").split(/\r?\n/);
    for (const line of lines) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("#")) continue;
      const sectionMatch = trimmed.match(/^\[(.+)]$/);
      if (sectionMatch) {
        section = sectionMatch[1];
        continue;
      }
      const kv = trimmed.match(/^([A-Za-z0-9_.-]+)\s*=\s*(.+)$/);
      if (!kv) continue;
      const key = section ? `${section}.${kv[1]}` : kv[1];
      let value = kv[2].trim();
      if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
        value = value.slice(1, -1);
      } else if (/^\d+$/.test(value)) {
        value = Number(value);
      } else if (value === "true" || value === "false") {
        value = value === "true";
      }
      out[key] = value;
    }
  } catch (_) {}
  return out;
}

function runJson(cmd, args, options = {}) {
  const proc = spawnSync(cmd, args, { encoding: "utf8", maxBuffer: 16 * 1024 * 1024, ...options });
  if (proc.status !== 0) return null;
  try {
    return JSON.parse(proc.stdout);
  } catch (_) {
    return null;
  }
}

function latestThread() {
  if (fs.existsSync(STATE_DB)) {
    const rows = runJson("sqlite3", [
      "-json",
      STATE_DB,
      `select id,cwd,title,tokens_used,cli_version,model,reasoning_effort,approval_mode,sandbox_policy,rollout_path,updated_at_ms
       from threads
       where archived = 0
       order by updated_at_ms desc
       limit 1;`,
    ]);
    if (Array.isArray(rows) && rows[0]) {
      return rows[0];
    }
  }
  const rollout = latestRolloutPath();
  return rollout ? { rollout_path: rollout, cwd: process.cwd() } : null;
}

function latestRolloutPath() {
  const root = path.join(CODEX_HOME, "sessions");
  const files = [];
  function walk(dir) {
    let entries = [];
    try {
      entries = fs.readdirSync(dir, { withFileTypes: true });
    } catch (_) {
      return;
    }
    for (const entry of entries) {
      const full = path.join(dir, entry.name);
      if (entry.isDirectory()) {
        walk(full);
      } else if (entry.isFile() && entry.name.endsWith(".jsonl")) {
        try {
          files.push({ file: full, mtimeMs: fs.statSync(full).mtimeMs });
        } catch (_) {}
      }
    }
  }
  walk(root);
  files.sort((a, b) => b.mtimeMs - a.mtimeMs);
  return files[0] ? files[0].file : null;
}

function latestTokenCount(rolloutPath) {
  if (!rolloutPath) return null;
  let lines;
  try {
    lines = fs.readFileSync(rolloutPath, "utf8").trimEnd().split(/\r?\n/);
  } catch (_) {
    return null;
  }
  for (let i = lines.length - 1; i >= 0; i--) {
    let item;
    try {
      item = JSON.parse(lines[i]);
    } catch (_) {
      continue;
    }
    const payload = item && item.payload;
    if (item.type === "event_msg" && payload && payload.type === "token_count") {
      return { timestamp: item.timestamp, ...payload };
    }
  }
  return null;
}

function requestRateLimits(timeoutMs = 12000) {
  return new Promise((resolve) => {
    const proc = spawn("codex", ["app-server"], { stdio: ["pipe", "pipe", "pipe"] });
    let stdout = "";
    let stderr = "";
    let done = false;
    const timer = setTimeout(() => finish(null, new Error("timed out reading codex app-server")), timeoutMs);

    function send(id, method, params) {
      proc.stdin.write(JSON.stringify({ id, method, ...(params === undefined ? {} : { params }) }) + "\n");
    }

    function finish(result, error) {
      if (done) return;
      done = true;
      clearTimeout(timer);
      try { proc.stdin.end(); } catch (_) {}
      try { proc.kill(); } catch (_) {}
      resolve({ result, error, stderr: stderr.trim() });
    }

    proc.stderr.on("data", (chunk) => {
      stderr += chunk.toString();
    });
    proc.stdout.on("data", (chunk) => {
      stdout += chunk.toString();
      let idx;
      while ((idx = stdout.indexOf("\n")) >= 0) {
        const line = stdout.slice(0, idx).trim();
        stdout = stdout.slice(idx + 1);
        if (!line) continue;
        let msg;
        try {
          msg = JSON.parse(line);
        } catch (_) {
          continue;
        }
        if (msg.id === 1 && msg.result) {
          send(2, "account/rateLimits/read");
        } else if (msg.id === 2) {
          if (msg.error) finish(null, new Error(msg.error.message || "rate limit read failed"));
          else finish(msg.result, null);
        }
      }
    });
    proc.on("error", (err) => finish(null, err));
    proc.on("exit", () => {
      if (!done) finish(null, new Error("codex app-server exited before returning rate limits"));
    });

    send(1, "initialize", {
      clientInfo: { name: "codex-pulse", title: "Codex Pulse", version: "0.1.0" },
      capabilities: { experimentalApi: true },
    });
  });
}

function bar(leftPercent, width = 20) {
  const filled = Math.max(0, Math.min(width, Math.round((leftPercent / 100) * width)));
  return "[" + "#".repeat(filled) + "-".repeat(width - filled) + "]";
}

function fmtNumber(num) {
  if (num === null || num === undefined || Number.isNaN(Number(num))) return "?";
  const n = Number(num);
  if (Math.abs(n) >= 1_000_000) return (n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1) + "M";
  if (Math.abs(n) >= 1_000) return Math.round(n / 1000) + "K";
  return String(n);
}

function fmtTime(tsSeconds) {
  if (!tsSeconds) return "?";
  const date = new Date(tsSeconds * 1000);
  const now = new Date();
  const sameDay = date.toDateString() === now.toDateString();
  const time = date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false });
  if (sameDay) return time;
  return `${time} on ${date.toLocaleDateString([], { month: "short", day: "numeric" })}`;
}

function fmtDuration(tsSeconds) {
  if (!tsSeconds) return "?";
  const delta = Math.max(0, Math.round(tsSeconds - Date.now() / 1000));
  const minutes = Math.round(delta / 60);
  if (minutes < 60) return `${minutes}m`;
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours < 48) return `${hours}h${mins ? `${mins}m` : ""}`;
  const days = Math.floor(hours / 24);
  const remHours = hours % 24;
  return `${days}d${remHours ? `${remHours}h` : ""}`;
}

function permissionText(thread) {
  if (!thread) return "unknown";
  let sandboxType = "unknown";
  try {
    const sandbox = typeof thread.sandbox_policy === "string" ? JSON.parse(thread.sandbox_policy) : thread.sandbox_policy;
    sandboxType = sandbox && sandbox.type ? sandbox.type : sandboxType;
  } catch (_) {}
  const approval = thread.approval_mode || "unknown";
  return `Custom (${sandboxType}, ${approval})`;
}

function findAgentsMd(cwd) {
  if (!cwd) return "<unknown>";
  let dir = cwd;
  while (dir && dir !== path.dirname(dir)) {
    for (const name of ["AGENTS.md", "Agents.md", "agents.md"]) {
      const candidate = path.join(dir, name);
      if (fs.existsSync(candidate)) return compactHome(candidate);
    }
    dir = path.dirname(dir);
  }
  return "<none>";
}

function contextUsage(tokenCount, config) {
  const info = tokenCount && tokenCount.info ? tokenCount.info : {};
  const last = info.last_token_usage || {};
  const window = info.model_context_window || config.model_context_window || null;
  const used = last.input_tokens || null;
  if (!window || !used) return null;
  const usedPct = Math.min(100, Math.round((used / window) * 100));
  return {
    used,
    window,
    usedPct,
    leftPct: Math.max(0, 100 - usedPct),
  };
}

function normalizeRateLimit(item) {
  if (!item) return null;
  const primary = item.primary || item.primary_window || null;
  const secondary = item.secondary || item.secondary_window || null;
  function normalizeWindow(win) {
    if (!win) return null;
    return {
      usedPercent: Number(win.usedPercent ?? win.used_percent ?? 0),
      windowMinutes: Number(win.windowDurationMins ?? win.window_minutes ?? 0),
      resetsAt: Number(win.resetsAt ?? win.resets_at ?? 0),
    };
  }
  return {
    limitId: item.limitId || item.limit_id || null,
    limitName: item.limitName || item.limit_name || null,
    planType: item.planType || item.plan_type || null,
    credits: item.credits || null,
    reached: item.rateLimitReachedType || item.rate_limit_reached_type || null,
    primary: normalizeWindow(primary),
    secondary: normalizeWindow(secondary),
  };
}

function rateLimitsFromTokenEvent(tokenCount) {
  const raw = tokenCount && tokenCount.rate_limits ? tokenCount.rate_limits : null;
  if (!raw) return null;
  const main = normalizeRateLimit(raw);
  return main ? { rateLimits: main, rateLimitsByLimitId: { [main.limitId || "codex"]: main } } : null;
}

async function collect() {
  const config = parseSimpleToml(CONFIG_FILE);
  const auth = readAuthInfo();
  const thread = latestThread();
  const tokenCount = latestTokenCount(thread && thread.rollout_path);
  const appServer = await requestRateLimits();
  let limits = null;
  if (appServer.result && appServer.result.rateLimits) {
    const byId = {};
    for (const [id, value] of Object.entries(appServer.result.rateLimitsByLimitId || {})) {
      byId[id] = normalizeRateLimit(value);
    }
    limits = {
      rateLimits: normalizeRateLimit(appServer.result.rateLimits),
      rateLimitsByLimitId: byId,
      source: "app-server",
    };
  } else {
    limits = rateLimitsFromTokenEvent(tokenCount);
    if (limits) limits.source = "session-cache";
  }
  return {
    collectedAt: new Date().toISOString(),
    config,
    auth,
    thread,
    tokenCount,
    context: contextUsage(tokenCount, config),
    limits,
    appServerError: appServer.error ? appServer.error.message : null,
  };
}

function printLimit(label, win) {
  if (!win) return;
  const left = Math.max(0, Math.round(100 - win.usedPercent));
  console.log(`  ${label.padEnd(28)} ${bar(left)} ${left}% left (used ${Math.round(win.usedPercent)}%, resets ${fmtTime(win.resetsAt)})`);
}

function printStatus(data, compact = false) {
  const thread = data.thread || {};
  const token = data.tokenCount || {};
  const info = token.info || {};
  const total = info.total_token_usage || {};
  const last = info.last_token_usage || {};
  const mainLimit = data.limits && data.limits.rateLimits;
  const plan = (mainLimit && mainLimit.planType) || data.auth.plan || "unknown";
  const model = thread.model || data.config.model || "unknown";
  const effort = thread.reasoning_effort || data.config.model_reasoning_effort || "unknown";
  const cwd = thread.cwd || process.cwd();
  const account = data.auth.email ? `${data.auth.email} (${plan})` : plan;

  if (compact) {
    const context = data.context ? `ctx:${data.context.usedPct}%/${fmtNumber(data.context.window)}` : "ctx:?";
    const five = mainLimit && mainLimit.primary ? `5h:${Math.round(100 - mainLimit.primary.usedPercent)}%` : "5h:?";
    const week = mainLimit && mainLimit.secondary ? `7d:${Math.round(100 - mainLimit.secondary.usedPercent)}%` : "7d:?";
    const tokens = total.total_tokens ? `total:${fmtNumber(total.total_tokens)}` : "total:?";
    console.log(`${context} ${five} ${week} ${tokens} ${model}`);
    return;
  }

  console.log(`OpenAI Codex (${thread.cli_version ? `v${thread.cli_version}` : "version unknown"})`);
  console.log("");
  console.log(`  Model:                       ${model} (reasoning ${effort})`);
  console.log(`  Directory:                   ${compactHome(cwd)}`);
  console.log(`  Permissions:                 ${permissionText(thread)}`);
  console.log(`  Agents.md:                   ${findAgentsMd(cwd)}`);
  console.log(`  Account:                     ${account}`);
  console.log(`  Session:                     ${thread.id || "<unknown>"}`);
  console.log("");
  if (data.context) {
    console.log(`  Context window:              ${data.context.leftPct}% left (${fmtNumber(data.context.used)} used / ${fmtNumber(data.context.window)})`);
  } else {
    console.log("  Context window:              <no token_count event found yet>");
  }
  if (total.total_tokens) {
    console.log(`  Session token total:          ${fmtNumber(total.total_tokens)} (input ${fmtNumber(total.input_tokens)}, cached ${fmtNumber(total.cached_input_tokens)}, output ${fmtNumber(total.output_tokens)}, reasoning ${fmtNumber(total.reasoning_output_tokens)})`);
  } else if (thread.tokens_used) {
    console.log(`  Session token total:          ${fmtNumber(thread.tokens_used)}`);
  }
  if (last.total_tokens) {
    console.log(`  Last turn tokens:             ${fmtNumber(last.total_tokens)} (input ${fmtNumber(last.input_tokens)}, cached ${fmtNumber(last.cached_input_tokens)}, output ${fmtNumber(last.output_tokens)}, reasoning ${fmtNumber(last.reasoning_output_tokens)})`);
  }
  if (mainLimit) {
    printLimit("5h limit:", mainLimit.primary);
    printLimit("Weekly limit:", mainLimit.secondary);
  }
  const byId = data.limits && data.limits.rateLimitsByLimitId ? data.limits.rateLimitsByLimitId : {};
  for (const [id, limit] of Object.entries(byId)) {
    if (!limit || id === (mainLimit && mainLimit.limitId)) continue;
    const label = limit.limitName || limit.limitId || id;
    console.log(`  ${label} limit:`);
    printLimit("    5h limit:", limit.primary);
    printLimit("    Weekly limit:", limit.secondary);
  }
  if (mainLimit && mainLimit.credits) {
    const credits = mainLimit.credits;
    console.log(`  Credits:                     ${credits.unlimited ? "unlimited" : credits.hasCredits ? credits.balance : "none"}`);
  }
  if (data.appServerError) {
    console.log(`  Warning:                     live rate limits unavailable (${data.appServerError}); used cached session data if present.`);
  } else if (data.limits && data.limits.source) {
    console.log(`  Source:                      ${data.limits.source}`);
  }
  if (token.timestamp) {
    console.log(`  Token event:                 ${token.timestamp}`);
  }
}

async function cmdWatch(args) {
  let interval = 10;
  let clear = true;
  for (let i = 0; i < args.length; i++) {
    if ((args[i] === "-i" || args[i] === "--interval") && args[i + 1]) {
      interval = Math.max(2, Number(args[++i]) || interval);
    } else if (args[i] === "--no-clear") {
      clear = false;
    }
  }
  process.on("SIGINT", () => {
    process.stdout.write("\n");
    process.exit(0);
  });
  while (true) {
    const data = await collect();
    if (clear && process.stdout.isTTY) process.stdout.write("\x1b[2J\x1b[H");
    printStatus(data);
    console.log("");
    console.log(`Refreshing every ${interval}s. Press Ctrl-C to stop.`);
    await new Promise((resolve) => setTimeout(resolve, interval * 1000));
  }
}

async function main() {
  const [cmd = "status", ...args] = process.argv.slice(2);
  if (cmd === "help" || cmd === "-h" || cmd === "--help") {
    usage();
    return;
  }
  if (cmd === "watch") {
    await cmdWatch(args);
    return;
  }
  const data = await collect();
  if (cmd === "json") {
    console.log(JSON.stringify(data, null, 2));
  } else if (cmd === "statusline") {
    printStatus(data, true);
  } else if (cmd === "status") {
    printStatus(data);
  } else {
    console.error(`Unknown command: ${cmd}`);
    usage();
    process.exitCode = 2;
  }
}

main().catch((err) => {
  console.error(`codex-pulse: ${err.message}`);
  process.exit(1);
});
